# Copia este archivo a ".env" para desarrollo local y completa los valores.
# En Vercel, configura estas mismas variables en Settings → Environment Variables.

# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---
# IMPORTANTE: usa la cadena del "Connection Pooler" (Transaction, puerto 6543),
# que es la adecuada para serverless. Reemplaza [PASSWORD] por tu contraseña.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres

# --- Supabase Storage (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# La SERVICE ROLE key es secreta: solo en el backend, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nombre del bucket donde se guardan las constancias (créalo como privado).
SUPABASE_BUCKET=constancias

# Opcional
# PORT=3000
